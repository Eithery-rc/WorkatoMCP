{
  "name": "@mokuhub/mokutab-shared",
  "version": "2.0.0",
  "description": "Tool schemas shared by the MokuTab bridge and Chrome extension",
  "author": "Roman Chikalenko <chikalenkor@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MokuHub/MokuTab.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/MokuHub/MokuTab#readme",
  "bugs": {
    "url": "https://github.com/MokuHub/MokuTab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "npx eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "npx eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json}\""
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^18.0.0",
    "tsup": "^8.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0"
  }
}
