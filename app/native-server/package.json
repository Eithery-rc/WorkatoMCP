{
  "name": "workatomcp-bridge",
  "version": "1.13.0",
  "description": "WorkatoMCP native messaging host (Chrome ↔ MCP bridge)",
  "main": "dist/index.js",
  "bin": {
    "workatomcp-bridge": "./dist/cli.js",
    "workatomcp-stdio": "./dist/mcp/mcp-server-stdio.js",
    "mcp-chrome-bridge": "./dist/cli.js",
    "chrome-mcp-bridge": "./dist/cli.js",
    "mcp-chrome-stdio": "./dist/mcp/mcp-server-stdio.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/ --exec \"npm run build && npm run register:dev\"",
    "build": "ts-node src/scripts/build.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json}\"",
    "register:dev": "node dist/scripts/register-dev.js",
    "postinstall": "node scripts/postinstall-guard.cjs"
  },
  "files": [
    "dist",
    "!dist/node_path.txt",
    "scripts/postinstall-guard.cjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "workato",
    "chrome",
    "chrome-extension",
    "browser",
    "ai-agents"
  ],
  "author": "Roman Chikalenko <chikalenkor@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eithery-rc/WorkatoMCP.git",
    "directory": "app/native-server"
  },
  "homepage": "https://github.com/Eithery-rc/WorkatoMCP#readme",
  "bugs": {
    "url": "https://github.com/Eithery-rc/WorkatoMCP/issues"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@types/node-fetch": "2",
    "chrome-devtools-frontend": "^1.0.1299282",
    "commander": "^13.1.0",
    "fastify": "^5.3.2",
    "is-admin": "^4.0.0",
    "node-fetch": "2",
    "uuid": "^11.1.0",
    "workatomcp-shared": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
